{
  // This repo's rules, and bin/lint-md.sh's wherever a repo has none or doesn't commit the file.
  // Agent-facing Markdown: no title heading, no hard wraps, bare code fences. Changelogs repeat group headings per release.
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD040": false,
    "MD041": false
  }
}
