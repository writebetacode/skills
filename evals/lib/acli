#!/bin/bash
# Fake acli for evals; Jira site acme.atlassian.net. State in .fake-acli/ at the repo root:
#   read:    search.json (what `jira workitem search` returns), workitem-<KEY>.json (`view`)
#   written: calls.log (every call)
root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
S=$root/.fake-acli
printf 'acli %s\n' "$*" >> "$S/calls.log"
die() { echo "$*" >&2; exit 1; }

case "$1" in --version|version) echo "acli version 1.3.39-stable (fake)"; exit 0 ;; esac
sub="$1 $2 $3"; shift 3
pos=()
while [ $# -gt 0 ]; do
  a=$1 takes=1
  case "$a" in --*=*) takes=0; a=${a%%=*} ;; esac
  case "$a" in -j) a=--jql ;; -l) a=--limit ;; -f) a=--fields ;; esac
  case "$sub:$a" in
    "jira workitem search:--jql"|"jira workitem search:--limit"|"jira workitem search:--fields"|"jira workitem view:--fields") : ;;
    *:--json|*:--count|*:--paginate) takes=0 ;;
    *:-*) die "fake acli: unsupported flag $a for acli $sub" ;;
    *) pos+=("$a"); takes=0 ;;
  esac
  [ "$takes" = 1 ] && shift
  shift
done

case "$sub" in
  "jira auth status") echo "✓ Authenticated to acme.atlassian.net as dev@example.com" ;;
  "jira workitem search") if [ -f "$S/search.json" ]; then cat "$S/search.json"; else echo '[]'; fi ;;
  "jira workitem view")
    [ -f "$S/workitem-${pos[0]}.json" ] || die "Error: work item ${pos[0]} does not exist or you do not have permission to see it."
    cat "$S/workitem-${pos[0]}.json" ;;
  *) die "fake acli: unsupported command: acli $sub" ;;
esac
