#!/bin/bash
# Fake glab for evals; project acme/shop on gitlab.com. State in .fake-glab/ at the repo root:
#   read:    merged-titles (one per line), mr.json (the branch's MR), issue-<n> (title)
#   written: calls.log (every call), mr-{title,assignee,target}, mr-body.md, mr.json
root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
S=$root/.fake-glab
URL=https://gitlab.com/acme/shop
printf 'glab %s\n' "$*" >> "$S/calls.log"
die() { echo "$*" >&2; exit 1; }

case "$1" in --version|version) echo "glab 1.122.0 (fake)"; exit 0 ;; esac
if [ "$1" = api ]; then sub=api; shift; else sub="$1 $2"; shift 2; fi
pos=() title="" bodyfile="" target="" source="" assignee="" draft="" merged=""
while [ $# -gt 0 ]; do
  a=$1 v="" takes=1
  case "$a" in --*=*) v=${a#*=}; a=${a%%=*} ;; esac
  case "$a" in -t) a=--title ;; -b) a=--target-branch ;; -s) a=--source-branch ;; -a) a=--assignee ;; -F) a=--output ;; -P) a=--per-page ;; -y) a=--yes ;; esac
  case "$a" in
    --title) title=${v:-$2} ;;
    --description-file) bodyfile=${v:-$2} ;;
    --target-branch) target=${v:-$2} ;;
    --source-branch) source=${v:-$2} ;;
    --assignee) assignee=${v:-$2} ;;
    --output|--per-page) : ;;
    --draft) draft=1; takes=0 ;;
    --merged) merged=1; takes=0 ;;
    --yes|--remove-source-branch) takes=0 ;;
    -*) die "fake glab: unsupported flag $a for glab $sub" ;;
    *) pos+=("$a"); takes=0 ;;
  esac
  [ -z "$v" ] && [ "$takes" = 1 ] && shift
  shift
done
branch=$(git -C "$root" branch --show-current)
default=$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')

case "$sub" in
  "auth status") echo "gitlab.com: ✓ Logged in to gitlab.com as dev" ;;
  "repo view") jq -n --arg u "$URL" --arg d "$default" '{id:42,path_with_namespace:"acme/shop",web_url:$u,default_branch:$d}' ;;
  api)
    case "${pos[0]}" in user) echo '{"id":7,"username":"dev"}' ;; *) die "fake glab: unsupported api call: ${pos[0]}" ;; esac ;;
  "mr list")
    if [ -n "$merged" ] && [ -f "$S/merged-titles" ]; then
      jq -R . "$S/merged-titles" | jq -s 'to_entries | map({iid:(.key+1),title:.value,state:"merged"})'
    else echo '[]'; fi ;;
  "mr view")
    [ -f "$S/mr.json" ] || die "no open merge request available for \"${pos[0]:-$branch}\""
    cat "$S/mr.json" ;;
  "issue view")
    [ -f "$S/issue-${pos[0]}" ] || die "404 Not Found"
    jq -n --arg n "${pos[0]}" --arg t "$(cat "$S/issue-${pos[0]}")" --arg u "$URL" \
      '{iid:($n|tonumber),title:$t,state:"opened",web_url:($u+"/-/issues/"+$n)}' ;;
  "mr create")
    [ -f "$S/mr.json" ] && die "Another open merge request already exists for this source branch"
    h=${source:-$branch}
    git -C "$root" ls-remote --exit-code origin "refs/heads/$h" > /dev/null || die "source branch \"$h\" not found on remote"
    [ -n "$bodyfile" ] && cat "$bodyfile" > "$S/mr-body.md"
    printf '%s\n' "$title" > "$S/mr-title"
    printf '%s\n' "$assignee" > "$S/mr-assignee"
    printf '%s\n' "${target:-$default}" > "$S/mr-target"
    jq -n --arg t "$title" --rawfile b "$S/mr-body.md" --arg h "$h" --arg tb "${target:-$default}" --arg u "$URL" --arg d "$draft" \
      '{iid:3,title:$t,description:$b,state:"opened",draft:($d!=""),web_url:($u+"/-/merge_requests/3"),source_branch:$h,target_branch:$tb}' > "$S/mr.json"
    echo "$URL/-/merge_requests/3" ;;
  *) die "fake glab: unsupported command: glab $sub" ;;
esac
