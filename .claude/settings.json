{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "Bash(git worktree remove *)",
      "Bash(git branch -D *)",
      "Bash(git tag -a v*)",
      "Bash(git push origin v*)",
      "Bash(gh release create *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/markdownlint.sh",
            "statusMessage": "Linting Markdown"
          }
        ]
      }
    ]
  }
}
